# ── HTTP server ──
PORT=9657
HOST=127.0.0.1
# Optional bearer token for every non-health endpoint.
# PROXY_API_KEY=
# Read the key from a file instead (Docker/Podman secret).
# PROXY_API_KEY_FILE=
# Fail at startup when no proxy key is configured (containers should set 1).
# REQUIRE_PROXY_API_KEY=0
# Extra browser origins allowed to call the proxy (comma-separated).
# PROXY_CORS_ORIGINS=http://localhost:3000

# ── Kimi account(s) ──
# Single file, comma-separated files, or a directory of JSON files.
KIMI_AUTH_PATH=./kimi-auth.json
# KIMI_AUTH_PATH=./account-1.json,./account-2.json
# KIMI_AUTH_DIR=./accounts
KIMI_BASE_URL=https://www.kimi.ai
# Optional: paste a JWT directly instead of using the auth file.
# KIMI_TOKEN=
# KIMI_COOKIE=
# KIMI_SHIELD=

# ── Chrome auth helper (scripts/kimi_chrome_auth.js) ──
# Path to Chrome / Chrome for Testing (auto-detected when empty).
KIMI_CHROME_PATH=
# Remote-debugging port for the auth browser (default: 9335).
KIMI_CHROME_PORT=
# Chrome profile directory used only for Kimi login.
# Default: ./.chrome-for-testing-profile-kimi (absolute resolution).
KIMI_CHROME_PROFILE=
# Reuse an existing Chrome profile instead:
#   KIMI_CHROME_PROFILE=C:\Users\you\AppData\Local\Google\Chrome\User Data
#   KIMI_CHROME_PROFILE_DIRECTORY=Profile 29
# Or point KIMI_CHROME_PROFILE directly at ...\User Data\Profile 29 — the
# helper detects the parent user-data-dir. Close ALL Chrome windows first.
# KIMI_CHROME_PROFILE_DIRECTORY=
# Keep the profile between runs (1/true). External profiles are never deleted.
KIMI_KEEP_CHROME_PROFILE=0
# Reuse an already-running auth Chrome (1/true).
KIMI_REUSE_CHROME=0
# Keep watching for refreshed tokens while the auth window stays open (1/true).
KIMI_AUTH_WATCH=1

# ── Model ──
# Internal web model id. K2.5 = k28-instant.
KIMI_MODEL=k28-instant
# Default: 1 = send thinking=true (reasoning_content).
KIMI_THINKING=1
# Default: 1 = enable Kimi's server-side web search tool.
KIMI_SEARCH=1
# REASONING_EFFORT_LOW | REASONING_EFFORT_MEDIUM | REASONING_EFFORT_HIGH
KIMI_REASONING_EFFORT=REASONING_EFFORT_LOW

# ── Browser emulation headers ──
# Auto-generated per account when empty.
KIMI_DEVICE_ID=
KIMI_SESSION_ID=
KIMI_SHIELD=
KIMI_TRAFFIC_ID=
KIMI_TIMEZONE=America/New_York
KIMI_LANGUAGE=en-US
# KIMI_USER_AGENT=

# ── Limits / recovery ──
KIMI_REQUEST_TIMEOUT_MS=300000
KIMI_STREAM_IDLE_TIMEOUT_MS=120000
KIMI_REQUEST_DEADLINE_MS=300000
KIMI_STREAM_KEEPALIVE_MS=10000
KIMI_MAX_CONCURRENT=24
KIMI_MAX_BODY_BYTES=26214400
KIMI_MAX_EMPTY_RETRIES=2
KIMI_MAX_PROMPT_CHARS=120000
KIMI_MIN_PROMPT_CHARS=8000
KIMI_ACCOUNT_COOLDOWN_MS=600000
KIMI_RATE_LIMIT_COOLDOWN_MS=60000

# ── Sessions ──
KIMI_SESSION_TTL_MS=7200000
KIMI_MAX_MESSAGE_DEPTH=100
KIMI_MAX_SESSION_CONTEXT_CHARS=150000
KIMI_MAX_HISTORY_LENGTH=15
KIMI_MAX_HISTORY_CHARS=10000
KIMI_MAX_HISTORY_ENTRY_CHARS=2000

# ── Branding metadata ──
# KIMI_WATERMARK=t.me/forgetmeai
